# ─── Database ────────────────────────────────────────────────
# Any PostgreSQL 13+ instance. For local dev you can run `npm run db:local`
# (embedded Postgres on port 5433) or `docker compose up -d`.
DATABASE_URL="postgresql://sangamam:sangamam@localhost:5433/sangamam?schema=public"

# ─── Auth ────────────────────────────────────────────────────
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# ─── Razorpay ────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use rzp_test_* keys while testing.
# The KEY_ID is public (sent to checkout); the SECRET never leaves the server.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks → secret for POST /api/webhooks/razorpay
# (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=""

# ─── App ─────────────────────────────────────────────────────
# Public base URL (used for invitation links & QR verification URLs)
APP_URL="http://localhost:3000"

# Initial admin account (created/updated by `npm run db:seed`)
ADMIN_EMAIL="admin@mvsrsangamam.in"
ADMIN_PASSWORD="change-me-strong-password"
