{
  "name": "mvsr-sangamam",
  "version": "1.0.0",
  "private": true,
  "description": "MVSR Sangamam 2026 — official fest registration, payments, teams, QR & check-in platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:all": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run start --prefix frontend",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "typecheck:backend": "npm run typecheck --prefix backend",
    "typecheck:frontend": "npm run typecheck --prefix frontend",
    "db:local": "node scripts/dev-db.mjs",
    "db:push": "npm run db:push --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "test:e2e": "tsx scripts/test-e2e.mjs",
    "test:api": "node scripts/test-api-e2e.mjs",
    "test:roundtrip": "node scripts/test-full-roundtrip.mjs",
    "test:extensive": "node scripts/test-extensive.mjs",
    "test:concurrency": "node scripts/test-concurrency-security.mjs",
    "test": "npm run test:e2e && npm run test:api && npm run test:roundtrip && npm run test:extensive && npm run test:concurrency"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource/orbitron": "^5.3.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "html5-qrcode": "2.3.8",
    "jose": "5.9.6",
    "lucide-react": "0.453.0",
    "next": "14.2.15",
    "qrcode": "1.5.4",
    "razorpay": "2.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "20.16.11",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "concurrently": "^9.1.2",
    "embedded-postgres": "17.2.0-beta.15",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "^4.23.15",
    "typescript": "5.6.3"
  }
}
